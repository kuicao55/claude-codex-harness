#!/usr/bin/env bash
# Pre-flight check for super-harness
# Works on the project repository (must be run from project root)
#
# Exit codes:
#   0 = proceed (check complete)
#   1 = warning (can continue but issues exist)
#   2 = error (should not proceed)
#
# Usage:
#   harness-preflight [--project-dir <path>]
#
# Flags:
#   --project-dir <path>   Use specified directory instead of current directory

set -e

PROJECT_DIR=""

# Parse flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        --project-dir) PROJECT_DIR="$2"; shift 2 ;;
        *) shift ;;
    esac
done

if [[ -n "$PROJECT_DIR" ]]; then
    cd "$PROJECT_DIR"
fi

show_warning() {
    echo "WARNING: $1"
}

show_info() {
    echo "INFO: $1"
}

show_error() {
    echo "ERROR: $1"
}

# Check helpers
has_git() {
    git rev-parse --git-dir >/dev/null 2>&1
}

has_progress() {
    [[ -f ".super-harness/status/claude-progress.json" ]]
}

# Track exit state
exit_code=0

# Check git initialization; if not present, auto-initialize
if ! has_git; then
    show_warning "Not a git repository. Initializing git..."
    git init
    echo "Git repository initialized."
fi

# Fresh project (no progress file)
if ! has_progress; then
    show_info "Fresh project detected. Creating directory structure..."

    mkdir -p .super-harness/status
    mkdir -p .super-harness/specs
    mkdir -p .super-harness/plans
    mkdir -p .super-harness/handoffs
    mkdir -p .super-harness/logs

    echo ""
    echo "Created directories:"
    echo "  - .super-harness/status/"
    echo "  - .super-harness/specs/"
    echo "  - .super-harness/plans/"
    echo "  - .super-harness/handoffs/"
    echo "  - .super-harness/logs/"
    echo ""
    show_info "Ready to start. Run /super-harness:brainstorm or /super-harness:plan to begin."

    exit $exit_code
fi

# Existing project: ensure directory structure exists
show_info "Existing project detected. Checking directory structure..."

for dir in .super-harness/specs .super-harness/plans .super-harness/handoffs .super-harness/logs; do
    if [[ ! -d "$dir" ]]; then
        mkdir -p "$dir"
        echo "  Created: $dir"
    else
        echo "  OK: $dir"
    fi
done

echo ""
echo "Pre-flight check complete."
